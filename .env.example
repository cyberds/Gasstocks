# Copy to .env.local for development, and set the same keys in the Vercel
# project settings for production. .env.local is gitignored — never commit real
# keys.

# ── Contact form (Phase 2) ────────────────────────────────────────────────
# Resend API key. Without it the form returns a 503 telling visitors to email
# directly, and logs the enquiry it could not deliver.
RESEND_API_KEY=

# Where enquiries are delivered. Defaults to COMPANY.email in lib/company.ts.
CONTACT_TO_EMAIL=info@gasstocksinc.org

# The From address. Resend will only send from a domain you have verified in
# their dashboard; until gasstocksltd.com is verified, leave this unset and the
# route falls back to onboarding@resend.dev, which delivers to the Resend
# account owner ONLY — fine for testing, not for production.
CONTACT_FROM_EMAIL=

# ── Chatbot ───────────────────────────────────────────────────────────────
# NEVER put a real key in this file — it is the committed template.
# Put real values in .env.local, which is gitignored.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Public ────────────────────────────────────────────────────────────────
# WhatsApp number, digits only, no '+'. Defaults to the Nigeria line.
# NEXT_PUBLIC_WHATSAPP_NUMBER=2348025240251

# ── Database & images (track record) ──────────────────────────────────────
# MongoDB Atlas connection string. The database name defaults to "gasstocks".
MONGODB_URI=
MONGODB_DB=gasstocks

# Cloudinary → Settings → API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Admin dashboard (/admin) ──────────────────────────────────────────────
# The master admin signs in with this email + password and can then authorize
# staff emails, who sign in with a one-time code emailed via Resend.
ADMIN_MASTER_EMAIL=
ADMIN_MASTER_PASSWORD=
# Random string, 32+ characters, used to sign sessions and hash codes:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=
# From address for sign-in codes. Falls back to CONTACT_FROM_EMAIL.
ADMIN_FROM_EMAIL=
